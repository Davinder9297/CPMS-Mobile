{
  "name": "cpms",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@reduxjs/toolkit": "^2.12.0",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.6",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.0",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "browserslist": "^4.28.6",
    "commander": "7.2.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "run:android": "expo run:android",
    "run:ios": "expo run:ios",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json}\"",
    "typecheck": "tsc --noEmit",
    "prebuild:android": "expo prebuild --platform android",
    "build:apk": "cd android && ./gradlew assembleRelease && mkdir -p ../releases && cp app/build/outputs/apk/release/app-release.apk ../releases/CPMS-v1.0.0-release.apk",
    "build:apk:win": "cd android && gradlew.bat assembleRelease && cd .. && (if not exist releases mkdir releases) && copy /Y android\\app\\build\\outputs\\apk\\release\\app-release.apk releases\\CPMS-v1.0.0-release.apk"
  },
  "private": true,
  "overrides": {
    "browserslist": "^4.28.6",
    "commander": "7.2.0"
  }
}
